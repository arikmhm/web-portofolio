---
// category must be `web`, `system`, or `ai` to match the filter buttons.
const projects = [
  { category: 'web', label: 'WEB & APPLICATIONS', title: 'Web & applications', description: 'Interfaces built around the people using them.' },
  { category: 'system', label: 'INTERNAL TOOLS', title: 'Internal tools', description: 'Making everyday work a little easier.' },
  { category: 'ai', label: 'AI & INTEGRATIONS', title: 'AI & integrations', description: 'Connecting information, tools, and useful intelligence.' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="portfolio section container" id="work" aria-labelledby="work-title">
  <div class="section-heading"><div><span class="eyebrow">03 / PORTFOLIO</span><h2 id="work-title">A closer look<br>at the <em>work.</em></h2></div><p>Different problems, different approaches. A closer look at the context, the decisions, and what came out of them.</p></div>
  <div class="portfolio-filters" role="group" aria-label="Filter work by category" hidden><button type="button" data-filter="all" aria-pressed="true">All work <span>{pad(projects.length)}</span></button><button type="button" data-filter="web" aria-pressed="false">Web &amp; apps</button><button type="button" data-filter="system" aria-pressed="false">Internal tools</button><button type="button" data-filter="ai" aria-pressed="false">AI &amp; integrations</button></div>
  <div class="portfolio-grid">
    {projects.map((project, i) => (
      <article class="project" data-category={project.category}>
        <div class={`project-preview preview-${project.category}`}><div class="preview-top"><span>{pad(i + 1)}</span><span>PROJECT PREVIEW</span></div><div class="screenshot-slot"><span class="frame-corner" aria-hidden="true"></span><span>Room for the real thing.</span><small>Project screenshots coming soon</small></div><span class="preview-bottom">{project.label}</span></div>
        <div class="project-caption"><div><h3>{project.title}</h3><p>{project.description}</p></div><span class="project-status">Coming soon</span></div>
      </article>
    ))}
  </div><span class="portfolio-count sr-only" role="status">{projects.length} project previews shown</span>
</section>
