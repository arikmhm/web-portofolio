---
import Arrow from './Arrow.astro';

// Tried and struck out before the heading settles on "right".
const decoys = ['fastest', 'trendiest'];
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-topline"><span class="eyebrow">ARIK MHM / THINKING &amp; BUILDING</span><span class="edition">A LITTLE CONTEXT. A LOT OF CARE.</span></div>
  <h1 id="hero-title" aria-label="Real problems. The right solution.">Real problems.<br><span>The <span class="hero-swap">{decoys.map((word) => <span aria-hidden="true">{word}</span>)}<mark>right</mark></span> <em>solution.</em></span></h1>
  <div class="hero-bottom">
    <div class="hero-copy"><p>I help make sense of the problem, then build a way forward. That might mean a clearer process, a useful application, or AI that takes some of the work off your hands.</p><a class="hero-cta" href="#contact">Let's talk <span class="cta-arrow" aria-hidden="true"><Arrow /><Arrow /></span></a></div>
  </div>
</section>
