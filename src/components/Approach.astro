---
const stages = [
  { label: 'THE QUESTION', title: "What's getting in the way?", text: 'A slow process, scattered information, or work that takes too much effort.' },
  { label: 'THE CONTEXT', title: 'Find the real need.', text: 'Map the people, rules, and constraints. Decide what needs to change.' },
  { label: 'THE BUILD', title: 'Build the useful parts.', text: 'Bring the flow, interface, and data together in a working system.' },
  { label: 'IF IT HELPS', title: 'Add intelligence where it helps.', text: 'Help people find or make sense of information, then check the results.', note: 'AI is an option, not a requirement.' },
  { label: 'THE RIGHT FIT', title: 'Make it fit real life.', text: 'Keep it clear to use, aligned with the workflow, and ready to improve.' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="solution" id="thinking" aria-labelledby="solution-title">
  <div class="approach-track">
    <div class="approach-pin">
      <div class="container approach-grid">
        <div class="approach-intro">
          <span class="eyebrow">01 / APPROACH</span>
          <h2 id="solution-title">From question<br>to <em>solution.</em></h2>
          <p>A good solution starts with the situation around it.</p>
          <div class="approach-progress" aria-hidden="true"><span class="approach-count">01</span><span class="approach-bar"></span><span>{pad(stages.length)}</span></div>
          <p class="solution-return"><span aria-hidden="true">↶</span>Try it in practice. Learn what works. Bring that learning back to the problem.</p>
        </div>
        <ol class="solution-stages">
          {stages.map((stage, i) => (
            <li class="stage">
              <div class="stage-card">
                <span class="stage-number" aria-hidden="true">{pad(i + 1)}</span>
                <div>
                  <div class="stage-fold"><div><span class="stage-index"><span class="sr-only">Step {i + 1}: </span>{stage.label}</span></div></div>
                  <h3>{stage.title}</h3>
                  <div class="stage-fold"><div><p>{stage.text}</p>{stage.note && <span class="stage-note">{stage.note}</span>}</div></div>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
